{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecosmarthomes-site",
  "compatibility_date": "2026-04-30",
  "observability": {
    "enabled": true
  },
  "main": "src/index.ts",
  "assets": {
    "directory": "site"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "ARTICLES_FEED",
      "id": "ARTICLES_FEED_KV_ID"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
