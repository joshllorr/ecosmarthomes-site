{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecosmarthomes-site",
  "compatibility_date": "2026-04-30",
  "observability": {
    "enabled": true
  },
  "main": "src/index.ts",
  "assets": {
    "directory": "site"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "ARTICLES",
      "id": "834d32b368064d139c657cbd28e12933"
    },
    {
      "binding": "ARTICLES_FEED",
      "id": "834d32b368064d139c657cbd28e12933"
    },
    {
      "binding": "ARTICLES_FEED_KV",
      "id": "834d32b368064d139c657cbd28e12933"
    },
    {
      "binding": "KV_BINDING",
      "id": "834d32b368064d139c657cbd28e12933"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MY_SEARCH",
      "bucket_name": "ecosmart-articles"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
