{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecosmarthome",
  "name": "ecosmarthomes-site",
  "compatibility_date": "2026-04-30",
  "observability": {
    "enabled": true
  },
  "main": "src/index.ts",
  "assets": {
    "directory": "site"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
