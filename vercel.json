{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/index.html", "destination": "/index.html" },
    { "source": "/articles/search", "destination": "/articles/index.html" },
    { "source": "/articles/tag/(.*)", "destination": "/articles/index.html" },
    { "source": "/articles/(.*)", "destination": "/articles/index.html" },
    { "source": "/(.*).html", "destination": "/index.html" }
  ]
}
